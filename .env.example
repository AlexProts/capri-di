# Capri only. Set in /etc/capri-di/capri.env on the server, never commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_ID=
OPENROUTER_API_KEY=
# Choose a model with tools support. No model is selected automatically.
OPENROUTER_MODEL=
STATE_DIR=/var/lib/capri-di/shared
# Enable only after logging Di into LMS and checking a read-only collection.
SCHEDULES_ENABLED=false
PROACTIVE_TESTS_ENABLED=false
TIME_ENABLED=false
# Moscow time. Telegram delivery follows completion of Di's collection.
DIGEST_HOURS=18
TIME_INTERVAL_HOURS=4
TIME_QUIET_START=0
TIME_QUIET_END=8
TEST_SCAN_HOUR=10
