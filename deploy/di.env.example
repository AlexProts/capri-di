STATE_DIR=/var/lib/capri-di/shared
DI_WORK_DIR=/var/lib/capri-di/di/jobs
DI_TIMEOUT_SECONDS=3600
CODEX_BIN=/opt/capri-di/node_modules/.bin/codex
CODEX_HOME=/var/lib/capri-di/di/.codex
PLAYWRIGHT_BROWSERS_PATH=/opt/capri-di/browsers
# Optional: model available in your ChatGPT/Codex subscription. Empty = Codex default.
CODEX_MODEL=
